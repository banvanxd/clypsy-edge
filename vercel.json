{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "dist",
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://paint-deaths-veterinary-sand.trycloudflare.com/:path*" },
    { "source": "/media/:path*", "destination": "https://paint-deaths-veterinary-sand.trycloudflare.com/media/:path*" },
    { "source": "/health", "destination": "https://paint-deaths-veterinary-sand.trycloudflare.com/health" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/brand/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "/((?!assets/|brand/|api/|media/|health).*)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    }
  ]
}
